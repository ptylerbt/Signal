# Copy this file to .env.local and fill in your real values.
# .env.local is already git-ignored — never commit real secrets.

# Neon → your project → Connection Details → "Connection string" (the one
# with sslmode=require already in it). Use the "pooled" connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Clerk → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk's default page URLs — these match the pages already scaffolded.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Comma-separated allowlist. Anyone who signs up but isn't on this list
# gets bounced to /not-authorized by middleware — this is what keeps
# sign-up "open" at the Clerk level but locked down in practice.
ALLOWED_USER_EMAILS=you@example.com,teammate@example.com
